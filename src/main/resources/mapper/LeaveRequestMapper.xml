<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinbo.myerp.mapper.LeaveRequestMapper">

    <resultMap id="leaveRequestResultMap" type="com.jinbo.myerp.domain.LeaveRequest">
        <id property="id" column="id"/>
        <result property="employeeId" column="employee_id"/>
        <result property="leaveType" column="leave_type"/>
        <result property="startDate" column="start_date"/>
        <result property="endDate" column="end_date"/>
        <result property="leaveDays" column="leave_days"/>
        <result property="reason" column="reason"/>
        <result property="status" column="status"/>
        <result property="approvedBy" column="approved_by"/>
        <result property="approvedAt" column="approved_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="columns">
        id, employee_id, leave_type, start_date, end_date, leave_days, reason,
        status, approved_by, approved_at, created_at
    </sql>

    <insert id="insert" parameterType="com.jinbo.myerp.domain.LeaveRequest" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO leave_request (employee_id, leave_type, start_date, end_date, leave_days, reason,
                                    status, approved_by, approved_at, created_at)
        VALUES (#{employeeId}, #{leaveType}, #{startDate}, #{endDate}, #{leaveDays}, #{reason},
                #{status}, #{approvedBy}, #{approvedAt}, #{createdAt})
    </insert>

    <select id="findById" resultMap="leaveRequestResultMap">
        SELECT <include refid="columns"/>
        FROM leave_request
        WHERE id = #{id}
    </select>

    <select id="findByEmployeeId" resultMap="leaveRequestResultMap">
        SELECT <include refid="columns"/>
        FROM leave_request
        WHERE employee_id = #{employeeId}
        ORDER BY id DESC
    </select>

    <update id="update" parameterType="com.jinbo.myerp.domain.LeaveRequest">
        UPDATE leave_request
        SET status = #{status},
            approved_by = #{approvedBy},
            approved_at = #{approvedAt}
        WHERE id = #{id}
    </update>

</mapper>
