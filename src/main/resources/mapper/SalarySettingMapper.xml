<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinbo.myerp.mapper.SalarySettingMapper">

    <resultMap id="salarySettingResultMap" type="com.jinbo.myerp.domain.SalarySetting">
        <id property="id" column="id"/>
        <result property="dailyWage" column="daily_wage"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="find" resultMap="salarySettingResultMap">
        SELECT id, daily_wage, updated_at
        FROM salary_setting
        ORDER BY id
        LIMIT 1
    </select>

    <insert id="insert" parameterType="com.jinbo.myerp.domain.SalarySetting" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO salary_setting (daily_wage, updated_at)
        VALUES (#{dailyWage}, #{updatedAt})
    </insert>

    <update id="update" parameterType="com.jinbo.myerp.domain.SalarySetting">
        UPDATE salary_setting
        SET daily_wage = #{dailyWage},
            updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

</mapper>
