<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinbo.myerp.mapper.ItemCertificationMapper">

    <insert id="insert">
        INSERT INTO item_certification (item_id, certification_id)
        VALUES (#{itemId}, #{certificationId})
    </insert>

    <delete id="deleteByItemId">
        DELETE FROM item_certification WHERE item_id = #{itemId}
    </delete>

    <select id="findCertificationsByItemId" resultType="com.jinbo.myerp.domain.Certification">
        SELECT c.id AS id, c.name AS name
        FROM certification c
        JOIN item_certification ic ON ic.certification_id = c.id
        WHERE ic.item_id = #{itemId}
        ORDER BY c.id
    </select>

</mapper>
