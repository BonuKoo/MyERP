<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jinbo.myerp.mapper.CertificationMapper">

    <resultMap id="certificationResultMap" type="com.jinbo.myerp.domain.Certification">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
    </resultMap>

    <insert id="insert" parameterType="com.jinbo.myerp.domain.Certification" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO certification (name)
        VALUES (#{name})
    </insert>

    <select id="findById" resultMap="certificationResultMap">
        SELECT id, name FROM certification WHERE id = #{id}
    </select>

    <select id="findByName" resultMap="certificationResultMap">
        SELECT id, name FROM certification WHERE name = #{name}
    </select>

    <select id="findAll" resultMap="certificationResultMap">
        SELECT id, name FROM certification ORDER BY id
    </select>

</mapper>
